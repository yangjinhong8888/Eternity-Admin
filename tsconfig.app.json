{
  "compilerOptions": {
    // 关键配置：生成声明文件
    // 是否输出声明文件
    "noEmit": true,
    // 生成对应的 .d.ts 声明文件
    "declaration": true,
    // 为每个声明文件生成对应的 map 文件，便于调试
    "declarationMap": false,
    // 不只输出声明文件，同时也输出编译后的 js 文件
    "emitDeclarationOnly": false,
    // 指定输出目录
    "outDir": "./dist",
    // 其他推荐配置
    // 指定声明文件的输出目录
    "declarationDir": "./dist/types",
    // 生成 source map 文件，便于调试
    "sourceMap": false,
    // 保留源码中的注释
    "removeComments": false,
    // 在package.json中配置这些参数之后，其他人使用打包后的项目时，也能引入类型信息
    // "main": "./dist/index.js",
    //  "types": "./dist/index.d.ts",
    //  "files": [
    //    "dist"
    //  ],


    // 指定tsbuildinfo文件的路径
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // 编译目标为ES2023
    "target": "ES2023",
    // 使用Object.defineProperty定义class字段
    "useDefineForClassFields": true,
    // 包含的库文件
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // 模块系统为ESNext
    "module": "ESNext",
    // 跳过声明文件的类型检查
    "skipLibCheck": true,

    /* Bundler mode */
    // 模块解析策略为bundler
    "moduleResolution": "bundler",
    // 允许导入ts扩展名
    "allowImportingTsExtensions": true,
    // 保留模块导入/导出语法
    "verbatimModuleSyntax": true,
    // 强制模块检测
    "moduleDetection": "force",
    // JSX的处理方式为react-jsx
    "jsx": "react-jsx",

    /* Linting */
    // 启用所有严格类型检查选项
    "strict": true,
    // 报告未使用的局部变量错误
    "noUnusedLocals": true,
    // 报告未使用的函数参数错误
    "noUnusedParameters": true,
    // 只移除类型注解，不进行转换
    "erasableSyntaxOnly": true,
    // 报告switch语句中的fallthrough错误
    "noFallthroughCasesInSwitch": true,
    // 检查副作用导入
    "noUncheckedSideEffectImports": true,

    /* Path Mapping */
    // 模块导入的基路径
    "baseUrl": ".",
    "paths": {
      // 路径映射
      // 映射@开头的导入路径到src目录
      "@/*": ["src/*"],
      // 映射@assets开头的导入路径到src/assets目录
      "@assets/*": ["src/assets/*"]
    }
  },
  // 包含src目录下的文件
  "include": ["src"],
  // 排除node_modules和test目录
  "exclude": ["node_modules", "dist", "test"]
}
